{
  "schemaVersion": 1,
  "targets": [
    {
      "environment": "esp32-color-kit",
      "otaEnabled": true,
      "manifestAsset": "app-market-esp32-color-kit.json",
      "app": {
        "id": "tp-color-kit-grande-ckos",
        "name": "ESP32 Gadget OS",
        "description": "Operating System for Color Kit Devices",
        "repository": "https://github.com/ThingPulse/esp32-gadget-os",
        "supportedDevices": [
          "tp-color-kit-grande"
        ],
        "tags": []
      },
      "icon": {
        "source": "documents/app-icon.png",
        "asset": "app-icon.png"
      },
      "partitions": [
        {
          "name": "Bootloader",
          "source": ".pio/build/esp32-color-kit/bootloader.bin",
          "asset": "esp32-color-kit-bootloader.bin",
          "offset": "0x1000"
        },
        {
          "name": "Partition table",
          "source": ".pio/build/esp32-color-kit/partitions.bin",
          "asset": "esp32-color-kit-partitions.bin",
          "offset": "0x8000"
        },
        {
          "name": "OTA data",
          "source": ".pio/build/esp32-color-kit/boot_app0.bin",
          "asset": "esp32-color-kit-boot-app0.bin",
          "offset": "0xe000"
        },
        {
          "name": "Firmware",
          "source": ".pio/build/esp32-color-kit/firmware.bin",
          "asset": "esp32-color-kit-firmware.bin",
          "offset": "0x10000"
        }
      ]
    },
    {
      "environment": "esp32-color-kit-pro",
      "otaEnabled": false,
      "manifestAsset": "app-market-esp32-color-kit-pro.json",
      "app": {
        "id": "tp-color-kit-grande-ckos-pro",
        "name": "ESP32 Gadget OS",
        "description": "Operating System for Color Kit Devices",
        "repository": "https://github.com/ThingPulse/esp32-gadget-os",
        "supportedDevices": [
          "tp-color-kit-pro"
        ],
        "tags": []
      },
      "icon": {
        "source": "documents/app-icon.png",
        "asset": "app-icon.png"
      },
      "partitions": [
        {
          "name": "Bootloader",
          "source": ".pio/build/esp32-color-kit-pro/bootloader.bin",
          "asset": "esp32-color-kit-pro-bootloader.bin",
          "offset": "0x0"
        },
        {
          "name": "Partition table",
          "source": ".pio/build/esp32-color-kit-pro/partitions.bin",
          "asset": "esp32-color-kit-pro-partitions.bin",
          "offset": "0x8000"
        },
        {
          "name": "OTA data",
          "source": ".pio/build/esp32-color-kit-pro/boot_app0.bin",
          "asset": "esp32-color-kit-pro-boot-app0.bin",
          "offset": "0xe000"
        },
        {
          "name": "Firmware",
          "source": ".pio/build/esp32-color-kit-pro/firmware.bin",
          "asset": "esp32-color-kit-pro-firmware.bin",
          "offset": "0x10000"
        }
      ]
    }
  ]
}
